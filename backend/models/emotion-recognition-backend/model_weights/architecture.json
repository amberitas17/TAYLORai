      "name": "conv2d_5"
    },
    {
      "type": "batch_norm",
      "name": "batch_normalization_5"
    },
    {
      "type": "conv2d",
      "filters": 128,
      "kernel_size": 3,
      "activation": "elu",
      "name": "conv2d_6"
